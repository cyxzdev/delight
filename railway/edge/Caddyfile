{
	auto_https off
	admin off
	servers {
		# Only Railway's proxy reaches the public port.
		trusted_proxies static 0.0.0.0/0 ::/0
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

:{$PORT:8080} {
	encode zstd gzip

	handle /_health {
		respond "OK" 200
	}

	handle_path /api/* {
		reverse_proxy {$API_HOST}:8080
	}

	handle /gateway {
		rewrite * /
		reverse_proxy {$GATEWAY_HOST}:8080
	}

	handle_path /gateway/* {
		reverse_proxy {$GATEWAY_HOST}:8080
	}

	handle_path /media/* {
		reverse_proxy {$MEDIA_PROXY_HOST}:8080
	}

	handle_path /livekit/* {
		reverse_proxy {$LIVEKIT_HOST}:7880
	}

	handle_path /delight/* {
		reverse_proxy {$DELIGHT_HOST}:3000
	}

	handle /admin {
		rewrite * /
		reverse_proxy {$DELIGHT_HOST}:3001
	}

	handle_path /admin/* {
		reverse_proxy {$DELIGHT_HOST}:3001
	}

	@staticAssets path /web/* /emoji/* /libs/* /avatars/* /badges/* /desktop/*
	handle @staticAssets {
		root * /srv/fluxer-static
		header {
			X-Content-Type-Options nosniff
			Access-Control-Allow-Origin *
			Cache-Control "public, max-age=3600, must-revalidate"
		}
		file_server
	}

	handle /.well-known/fluxer {
		reverse_proxy {$API_HOST}:8080
	}

	handle {
		reverse_proxy {$APP_HOST}:8080
	}
}

# Internal: app-proxy reads instance discovery from here.
:8088 {
	handle /.well-known/fluxer {
		reverse_proxy {$API_HOST}:8080
	}
}
